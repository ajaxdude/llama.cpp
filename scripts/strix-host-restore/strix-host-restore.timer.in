[Unit]
Description=Run the signed Strix Halo host baseline restore at its deadline
Documentation=file:///usr/local/share/doc/strix-host-restore/README.md

[Timer]
OnCalendar=@RESTORE_DEADLINE_UTC@
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=strix-host-restore.service

[Install]
WantedBy=timers.target
